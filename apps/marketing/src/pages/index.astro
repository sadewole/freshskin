---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Story from '../components/Story.astro';
import TrustRow from '../components/TrustRow.astro';
import HowItWorks from '../components/HowItWorks.astro';
import LabelCheck from '../components/LabelCheck.astro';
import Tones from '../components/Tones.astro';
import Scent from '../components/Scent.astro';
import Coach from '../components/Coach.astro';
import Proof from '../components/Proof.astro';
import Faq from '../components/Faq.astro';
import Finale from '../components/Finale.astro';
import Footer from '../components/Footer.astro';

const title = 'FreshSkin — skincare and scent that actually fits you';
const description =
  'Photograph your skin, scan any label, and get recommendations with reasons you can check. Free at launch.';
---

<Base title={title} description={description}>
  <Header />
  <main id="main">
    <Hero />
    <Story />
    <TrustRow />
    <HowItWorks />
    <Tones />
    <LabelCheck />
    <Scent />
    <Coach />
    <Proof />
    <Faq />
    <Finale />
  </main>
  <Footer />
</Base>
