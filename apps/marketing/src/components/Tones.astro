---
// Tone is read to match, never to rank. The strip is one continuous band of six
// reference swatches — deliberately unnumbered, so it cannot be read as a scale.
---

<section class="sec tones" id="tones">
  <span class="ghost" data-word="Tone" aria-hidden="true"></span>
  <div class="wrap">
    <div class="tones__head reveal">
      <div>
        <span class="kicker">Every skin tone</span>
        <h2 class="h2">Read the same way, from the start.</h2>
      </div>
      <p class="body">
        Tone tells us how to match, not how to judge. It is measured so the advice fits
        you — never scored, ranked, or treated as something to change.
      </p>
    </div>

    <div class="strip reveal" role="img" aria-label="Six reference skin tone bands, from light to deep">
      <span></span><span></span><span></span><span></span><span></span><span></span>
    </div>
    <p class="strip-caption reveal">
      Reference bands used for matching. Not a scale, and not a ranking.
    </p>
  </div>
</section>
