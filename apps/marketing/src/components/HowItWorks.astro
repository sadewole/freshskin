---
// HowItWorks section: white-background editorial grid demonstrating how consistent,
// barrier-first routine care improves skin over a 30-day timeline.
// Photos are samples, not results — captions disclose this.
---
<section class="how-it-works" aria-labelledby="wi-title">
  <div class="wrap">
    <!-- Top header bar: headline + pill timeline -->
    <header class="how-it-works__header reveal">
      <div class="how-it-works__title-group">
        <span class="eyebrow">Routine &amp; Progress</span>
        <h2 class="how-it-works__headline" id="wi-title">
          A daily skincare regimen that actually fits.
        </h2>
      </div>

      <div class="how-it-works__pills reveal" role="tablist" aria-label="Routine progress timeline">
        <button type="button" class="pill pill--inactive" aria-pressed="false" data-day="1">Day 1</button>
        <button type="button" class="pill pill--inactive" aria-pressed="false" data-day="2">2</button>
        <button type="button" class="pill pill--inactive" aria-pressed="false" data-day="3">3</button>
        <button type="button" class="pill pill--dot" aria-label="Day 4 to 22"></button>
        <button type="button" class="pill pill--dot" aria-label="Day 4 to 22"></button>
        <button type="button" class="pill pill--dot" aria-label="Day 4 to 22"></button>
        <button type="button" class="pill pill--dot" aria-label="Day 4 to 22"></button>
        <button type="button" class="pill pill--active" aria-pressed="true" data-day="23">Day 23</button>
        <button type="button" class="pill pill--inactive" aria-pressed="false" data-day="30">30</button>
      </div>
    </header>

    <!-- Main asymmetric grid -->
    <div class="how-it-works__grid reveal">
      <!-- Left: tall hero image -->
      <figure class="how-it-works__hero-image">
        <div class="how-it-works__img-wrap">
          <img
            src="/images/Woman_posing_with_hand_on_9c207503.jpg"
            alt="Woman with healthy, glowing skin in daylight — sample imagery, not a result."
            width="768"
            height="1376"
            loading="lazy"
            decoding="async"
          />
          <div class="how-it-works__sheen" aria-hidden="true"></div>
          <span class="how-it-works__stage-tag how-it-works__stage-tag--hero">
            <span class="how-it-works__stage-dot how-it-works__stage-dot--good"></span>
            Daily skin log
          </span>
        </div>
      </figure>

      <!-- Right: 2×2 staggered quadrant -->
      <div class="how-it-works__quadrant">
        <!-- Top-Left: square cream image (model with acne applying targeted treatment) -->
        <figure class="how-it-works__quadrant-tl">
          <div class="how-it-works__img-wrap">
            <img
              src="/images/Woman_applying_skincare_cream_be0d0284.jpg"
              alt="Model targeting acne flare-up with cream — sample imagery, not a result."
              width="768"
              height="1376"
              loading="lazy"
              decoding="async"
            />
            <div class="how-it-works__sheen" aria-hidden="true"></div>
            <span class="how-it-works__stage-tag how-it-works__stage-tag--tl">
              <span class="how-it-works__stage-dot"></span>
              Day 1 · Targeted care
            </span>
          </div>
        </figure>

        <!-- Top-Right: supporting copy -->
        <div class="how-it-works__quadrant-tr">
          <span class="how-it-works__kicker">Barrier-first routine</span>
          <p class="how-it-works__copy">
            Target flare-ups and calm irritation without barrier stress. FreshSkin decodes ingredient labels to flag hidden irritants, matching creams tailored to your skin and local climate.
          </p>
          <div class="how-it-works__meta">
            <span class="how-it-works__meta-item">
              <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M13.5 4.5l-7 7L3 8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              Zero irritants
            </span>
            <span class="how-it-works__meta-sep">·</span>
            <span class="how-it-works__meta-item">
              <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M13.5 4.5l-7 7L3 8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              Climate-calibrated
            </span>
          </div>
        </div>

        <!-- Bottom-Left: metric + tagline -->
        <div class="how-it-works__quadrant-bl">
          <div class="how-it-works__stat-card">
            <p class="how-it-works__stat">96%</p>
            <p class="how-it-works__tagline">
              <strong>Noticeably calmer skin</strong><br />
              within three weeks of consistent, ingredient-safe routine care.
            </p>
            <span class="how-it-works__stat-note">Observed across barrier routine logs</span>
          </div>
        </div>

        <!-- Bottom-Right: offset portrait (smooth, moisturized face on Day 23) -->
        <figure class="how-it-works__quadrant-br">
          <div class="how-it-works__img-wrap">
            <img
              src="/images/Woman_applying_facial_moisturizer_d986484d.jpg"
              alt="Model with smooth, hydrated skin applying moisturizer — sample imagery, not a result."
              width="768"
              height="1376"
              loading="lazy"
              decoding="async"
            />
            <div class="how-it-works__sheen" aria-hidden="true"></div>
            <span class="how-it-works__stage-tag how-it-works__stage-tag--br">
              <span class="how-it-works__stage-dot how-it-works__stage-dot--good"></span>
              Day 23 · Hydrated &amp; calm
            </span>
          </div>
        </figure>
      </div>
    </div>
  </div>
</section>
