---
// Answers taken from the shipped behaviour, not invented: retention (§16),
// the 0.55 retake floor (AC-1.3), the no-diagnosis rule (§5), free at launch (§22 D3).
const items = [
{
q: 'What happens to my photos?',
a: 'They are deleted within 24 hours, unless you turn on "keep my photos", which is off by default. You can delete an analysis yourself at any time.',
},
{
q: 'What if the photo is unclear?',
a: 'Below 55% confidence we say so and ask for another photo. We do not build recommendations on a photo we could not read.',
},
{
q: 'Is this medical advice?',
a: 'No. FreshSkin is not a diagnosis and not a substitute for a doctor. If something is painful, spreading, or not healing, please see one.',
},
{
q: 'What does it cost?',
a: 'It is free at launch. No subscription, and no paywall on safety advice.',
},
{
q: 'Will it work on a slow connection?',
a: 'It is built for 3G. Photos upload in the background, the screen says what it is doing, and a dropped connection picks up where it stopped.',
},
];
---

<section class="sec faq" id="faq">
<div class="wrap faq__in">
<div class="reveal">
<span class="kicker">Need to know</span>
<h2 class="h2">Need to know: how the analysis works.</h2>
<div class="faq__ask">
<b>Need more details?</b>
<p>Write to us and we will answer with the reason attached.</p>
<a href="mailto:hello@freshskin.com">hello@freshskin.com</a>
</div>
</div>

<div class="reveal">
{
items.map((item) => (
<details>
<summary>
<span>{item.q}</span>
</summary>
<p>{item.a}</p>
</details>
))
}
</div>
</div>
</section>
