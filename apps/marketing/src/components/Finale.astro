---
const app = 'https://app.freshskin.com/?utm_source=freshskin.com&utm_medium=referral&utm_campaign=final_cta';
---

<section class="sec finale" id="get">
<span class="ghost" data-word="FreshSkin" aria-hidden="true"></span>
<div class="wrap reveal">
<h2 class="display">Stop guessing with your routine. <span class="fade">Start with one photo.</span></h2>
<p>
It runs in your browser, so there is nothing to install. Add it to your home screen
if you want it close.
</p>
<a class="pill" href={app}>
Open FreshSkin
<i aria-hidden="true">
<svg width="14" height="14" viewBox="0 0 16 16" fill="none">
<path
d="M3 8h9M8.5 4.5 12 8l-3.5 3.5"
stroke="currentColor"
stroke-width="1.6"
stroke-linecap="round"
stroke-linejoin="round"
/>
</svg>
</i>
</a>
</div>
</section>
